 436   2                    - 如果是只通过太阳能充电，但是太阳能电压低于电池电压，
 437   2                    此时充电IC又会输出30秒的放电信号，导致这里误判为放电.
 438   2                    正在对外放电时，type-c口的电压应该由充电芯片的升压
 439   2                    提升到5V，这里检测到的电压应该非常接近5V，所以可以区分
 440   2                    是在放电还是太阳能充电导致充电ic输出了放电信号
 441   2              */
 442   2      
 443   2              if (is_detect_discharge_signal &&
 444   2                  type_c_vol_mv >= (4800 - 100)) // 留出 100mv 的误差
 445   2              {
 446   3                  /*
 447   3                      检测到放电信号，并且 type-c 口电压要大于
 448   3                      (4800 - 100)mV，才认为是在放电
 449   3                      放电时，充电ic有升压和补偿，应该是稳定的接近5V的电压，
 450   3                      电压不会被负载拉得过低
 451   3      
 452   3                      用于区分太阳能一侧电压下降后，充电IC输出了放电信号
 453   3                  */
 454   3      
 455   3                  is_discharge_det_time_cnt++;
 456   3                  if (is_discharge_det_time_cnt >= 200)
 457   3                  {
 458   4                      is_discharge_det_time_cnt = 0;
 459   4                      // 累计一段时间后，才认为正在放电
 460   4                      is_in_discharging = 1;
 461   4                  }
 462   3              }
 463   2              else
 464   2              {
 465   3                  is_discharge_det_time_cnt = 0;
 466   3                  is_in_discharging = 0;
 467   3              }
 468   2          }
 469   1          else if (type_c_vol_mv <= 2500 ||
 470   1                   solar_panel_vol_mv < (voltage_mv_global + 200))
 471   1          {
 472   2              // 充电口电压已经很低，或者太阳能侧输入已经不再有效时，
 473   2              // 说明此时不是实际放电，直接清掉放电状态，避免误判。
 474   2              is_discharge_det_time_cnt = 0;
 475   2              is_in_discharging = 0;
 476   2              is_detect_discharge_signal = 0;
 477   2          }
 478   1          else
C51 COMPILER V9.60.7.0   CHARGE_DET                                                        07/30/2026 16:16:50 PAGE 9   

 479   1          {
 480   2              // 处于 2V~4V 之间的过渡区间时，先不作为有效放电判定，
 481   2              // 避免在输入电压下降时把“弱输入/误触发”误认为真正放电。
 482   2              is_discharge_det_time_cnt = 0;
 483   2              is_in_discharging = 0;
 484   2          }
 485   1      
 486   1          // printf("adc_val_of_solar_panel == %u\n", adc_val_of_solar_panel);
 487   1      
 488   1          if (is_in_charging_by_charger || is_in_charging_by_solar_panel)
 489   1          {
 490   2              is_in_charging = 1;
 491   2      
 492   2              // 有充电之后，清空低电量相关标志位
 493   2              is_sent_low_bat_alert = 0;
 494   2      
 495   2              // 充电时取消低电量缓慢调节限制，恢复正常缓慢调节
 496   2              led_ctl.is_cancel_slowly_adjust = 0;
 497   2      
 498   2              is_dev_close_enable = 0; // 充电时，清空控制关机的标志位
 499   2          }
 500   1          else if (is_in_charging_by_charger == 0 && is_in_charging_by_solar_panel == 0)
 501   1          {
 502   2              is_in_charging = 0;
 503   2          }
 504   1      
