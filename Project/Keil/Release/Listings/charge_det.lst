 434   1      #if USER_DEBUG_ENABLE
                  // printf("adc_val_of_type_c == %u\n", adc_val_of_type_c);
              #endif
 437   1          if (adc_val_of_type_c <= 2000 ||
 438   1              voltage_mv < (avg_voltage_mv + 200))
 439   1          {
 440   2              // 充电口电压已经很低，或者太阳能侧输入已经不再有效时，
 441   2              // 说明此时不是实际放电，直接清掉放电状态，避免误判。
 442   2              is_discharge_det_time_cnt = 0;
 443   2              // isnot_discharge_det_time_cnt = 0;
 444   2              is_in_discharging = 0;
 445   2              is_detect_discharge_signal = 0;
 446   2          }
 447   1          else if (adc_val_of_type_c >= 4000)
 448   1          {
 449   2              // 充电口的电压接近 5V，认为在通过 type-C 进行充电或者放电
 450   2              if (is_detect_discharge_signal)
 451   2              {
 452   3                  // isnot_discharge_det_time_cnt = 0;
 453   3                  is_discharge_det_time_cnt++;
 454   3                  if (is_discharge_det_time_cnt >= 200)
 455   3                  {
 456   4                      is_discharge_det_time_cnt = 0;
 457   4                      // 累计一段时间后，才认为正在放电
 458   4                      is_in_discharging = 1;
 459   4                  }
 460   3              }
 461   2          }
 462   1          else
 463   1          {
 464   2              // 处于 2V~4V 之间的过渡区间时，先不作为有效放电判定，
 465   2              // 避免在输入电压下降时把“弱输入/误触发”误认为真正放电。
 466   2              is_discharge_det_time_cnt = 0;
 467   2              // isnot_discharge_det_time_cnt = 0;
 468   2              is_in_discharging = 0;
 469   2          }
 470   1      
 471   1          // printf("adc_val_of_solar_panel == %u\n", adc_val_of_solar_panel);
 472   1      
 473   1          if (is_in_charging_by_charger || is_in_charging_by_solar_panel)
 474   1          {
 475   2              is_in_charging = 1;
 476   2      
 477   2              // 有充电之后，清空低电量相关标志位
 478   2              is_sent_low_bat_alert = 0;  
 479   2          }
C51 COMPILER V9.60.7.0   CHARGE_DET                                                        07/24/2026 13:53:25 PAGE 9   

 480   1          else if (is_in_charging_by_charger == 0 && is_in_charging_by_solar_panel == 0)
 481   1          {
 482   2              is_in_charging = 0;
 483   2          }
 484   1      
