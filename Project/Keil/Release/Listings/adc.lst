 215          // 目前在低功耗唤醒后会使用
 216          u16 adc_get_val_once(void)
 217          {
 218   1          ADC_CFG0 |= ADC_CHAN0_TRG(0x1); // 触发ADC0转换
 219   1          while (!(ADC_STA & ADC_CHAN0_DONE(0x1)))
 220   1              ;                                           // 等待转换完成
 221   1          ADC_STA = ADC_CHAN0_DONE(0x1);                  // 清除ADC0转换完成标志位
 222   1          return ((ADC_DATAH0 << 4) | (ADC_DATAL0 >> 4)); // 读取ADC0的值
 223   1      }
