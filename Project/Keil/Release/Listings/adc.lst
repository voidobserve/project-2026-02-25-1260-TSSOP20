 160          void adc_channel_sel(adc_channel_sel_t adc_channel)
 161          {
 162   1          ADC_ACON1 &= ~(ADC_VREF_SEL(0x07) |  // 清空参考电压选择位
 163   1                         ADC_EXREF_SEL(0x01) | // 关闭外部参考电压
 164   1                         ADC_INREF_SEL(0x01)); // 关闭内部参考电压
 165   1      
 166   1          switch (adc_channel)
 167   1          {
 168   2          case ADC_CHANNEL_SEL_AD_KEY:
 169   2              // ADC配置
 170   2              ADC_ACON1 |= ADC_VREF_SEL(0x06) | // 选择 VCC 作为参考电压
 171   2                           ADC_TEN_SEL(0x03);   // 关闭测试信号
 172   2              ADC_CHS0 = ADC_ANALOG_CHAN(0x14); // 选则引脚对应的通道（0x14--P24）
 173   2              break;
 174   2          case ADC_CHANNEL_SEL_BAT_DET:
 175   2              ADC_ACON1 |= ADC_VREF_SEL(0x01) | // 选择 内部2.0V 作为参考电压
 176   2                           ADC_TEN_SEL(0x03) |  // 关闭测试信号
C51 COMPILER V9.60.7.0   ADC                                                               07/24/2026 13:53:24 PAGE 4   

 177   2                           ADC_INREF_SEL(0x01); // 使能内部参考电压
 178   2              ADC_CHS0 = ADC_EXT_SEL(0x01) |    // 选择内部通道
 179   2                         ADC_ANALOG_CHAN(0x03); // 选择 VDD 1/5 分压的通道
 180   2              break;
 181   2          case ADC_CHANNEL_SEL_SOLAR_DET:
 182   2              //  0 ~ 5 V， 经过二极管0.3V后，实际的充电电压范围：0 ~ 4.7V
 183   2              // 经过 1/2 分压后，单片机检测到的电压范围：0 ~ 2.35V
 184   2              // 使用2.4V参考电压
 185   2              ADC_ACON1 |= ADC_VREF_SEL(0x02) | // 选择 内部2.4V 作为参考电压
 186   2                           ADC_TEN_SEL(0x03) |  // 关闭测试信号
 187   2                           ADC_INREF_SEL(0x01); // 使能内部参考电压
 188   2              ADC_CHS0 = ADC_ANALOG_CHAN(0x0C); // 选则引脚对应的通道（0x0C -- P14）
 189   2              break;
 190   2      
 191   2          case ADC_CHANNEL_SEL_TYPE_C:
 192   2              ADC_ACON1 |= ADC_VREF_SEL(0x01) | // 选择 内部2.0V 作为参考电压
 193   2                           ADC_TEN_SEL(0x03) |  // 关闭测试信号
 194   2                           ADC_INREF_SEL(0x01); // 使能内部参考电压
 195   2              ADC_CHS0 = ADC_ANALOG_CHAN(0x0E); // 选则引脚对应的通道（0x0E -- P16）
 196   2              break;
 197   2      
 198   2          default:
 199   2              break;
 200   2          }
 201   1      
 202   1          ADC_CFG0 |= ADC_CHAN0_EN(0x1) | // 使能通道0
 203   1                      ADC_EN(0x1);        // 使能adc
 204   1      }
