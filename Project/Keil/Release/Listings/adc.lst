 227          // 由1ms及以上的定时器调用
 228          void adc_scan(void)
 229          {
 230   1      
 231   1          switch (cur_adc_status)
 232   1          {
 233   2          case ADC_STATUS_IDLE:
 234   2          // case ADC_STATUS_SEL_SOLAR_DET:
 235   2          case ADC_STATUS_SEL_TYPE_C:
 236   2              adc_channel_sel(ADC_CHANNEL_SEL_AD_KEY);
 237   2              cur_adc_status = ADC_STATUS_SEL_AD_KEY_WAITING;
C51 COMPILER V9.60.7.0   ADC                                                               07/24/2026 13:53:24 PAGE 5   

 238   2              break;
 239   2          case ADC_STATUS_SEL_AD_KEY_WAITING:
 240   2              // 开启转换，之后在ad中断获取ad值
 241   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 242   2              cur_adc_status = ADC_STATUS_SEL_AD_KEY;
 243   2              break;
 244   2          case ADC_STATUS_SEL_AD_KEY:
 245   2              adc_channel_sel(ADC_CHANNEL_SEL_BAT_DET);
 246   2              cur_adc_status = ADC_STATUS_SEL_BAT_DET_WAITING;
 247   2              break;
 248   2          case ADC_STATUS_SEL_BAT_DET_WAITING:
 249   2              // 准备采集电池电压对应的ad值前，先关闭led显示，不包括电量指示灯
 250   2              // led_suspend();
 251   2      
 252   2              // 开启转换，之后在ad中断获取ad值 
 253   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 254   2              cur_adc_status = ADC_STATUS_SEL_BAT_DET;
 255   2              break;
 256   2          case ADC_STATUS_SEL_BAT_DET:
 257   2              adc_channel_sel(ADC_CHANNEL_SEL_SOLAR_DET);
 258   2              cur_adc_status = ADC_STATUS_SEL_SOLAR_DET_WAITING;
 259   2              break;
 260   2          case ADC_STATUS_SEL_SOLAR_DET_WAITING:
 261   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 262   2              cur_adc_status = ADC_STATUS_SEL_SOLAR_DET;
 263   2              break;
 264   2          case ADC_STATUS_SEL_SOLAR_DET:
 265   2              adc_channel_sel(ADC_CHANNEL_SEL_TYPE_C);
 266   2              cur_adc_status = ADC_STATUS_SEL_TYPE_C_WAITING;
 267   2              break;
 268   2          case ADC_STATUS_SEL_TYPE_C_WAITING:
 269   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 270   2              cur_adc_status = ADC_STATUS_SEL_TYPE_C;
 271   2              break;
 272   2      
 273   2          default:
 274   2              break;
 275   2          } 
 276   1      }
