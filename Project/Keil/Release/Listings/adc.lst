 225          // 由1ms及以上的定时器调用
 226          void adc_scan(void)
 227          {
 228   1      
 229   1          switch (cur_adc_status)
 230   1          {
 231   2          case ADC_STATUS_IDLE:
 232   2          // case ADC_STATUS_SEL_SOLAR_DET:
 233   2          case ADC_STATUS_SEL_TYPE_C:
 234   2              adc_channel_sel(ADC_CHANNEL_SEL_AD_KEY);
 235   2              cur_adc_status = ADC_STATUS_SEL_AD_KEY_WAITING;
 236   2              break;
 237   2          case ADC_STATUS_SEL_AD_KEY_WAITING:
C51 COMPILER V9.60.7.0   ADC                                                               07/31/2026 17:59:07 PAGE 5   

 238   2              // 开启转换，之后在ad中断获取ad值
 239   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 240   2              cur_adc_status = ADC_STATUS_SEL_AD_KEY;
 241   2              break;
 242   2          case ADC_STATUS_SEL_AD_KEY:
 243   2              adc_channel_sel(ADC_CHANNEL_SEL_BAT_DET);
 244   2              cur_adc_status = ADC_STATUS_SEL_BAT_DET_WAITING;
 245   2              break;
 246   2          case ADC_STATUS_SEL_BAT_DET_WAITING:
 247   2              // 开启转换，之后在ad中断获取ad值
 248   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 249   2              cur_adc_status = ADC_STATUS_SEL_BAT_DET;
 250   2              break;
 251   2          case ADC_STATUS_SEL_BAT_DET:
 252   2              adc_channel_sel(ADC_CHANNEL_SEL_SOLAR_DET);
 253   2              cur_adc_status = ADC_STATUS_SEL_SOLAR_DET_WAITING;
 254   2              break;
 255   2          case ADC_STATUS_SEL_SOLAR_DET_WAITING:
 256   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 257   2              cur_adc_status = ADC_STATUS_SEL_SOLAR_DET;
 258   2              break;
 259   2          case ADC_STATUS_SEL_SOLAR_DET:
 260   2              adc_channel_sel(ADC_CHANNEL_SEL_TYPE_C);
 261   2              cur_adc_status = ADC_STATUS_SEL_TYPE_C_WAITING;
 262   2              break;
 263   2          case ADC_STATUS_SEL_TYPE_C_WAITING:
 264   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 265   2              cur_adc_status = ADC_STATUS_SEL_TYPE_C;
 266   2              break;
 267   2      
 268   2          default:
 269   2              break;
 270   2          }
 271   1      }
