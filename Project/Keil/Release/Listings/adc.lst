 273          void ADC_IRQHandler(void) interrupt ADC_IRQn
 274          {
 275   1          volatile u16 adc_val;
 276   1      
 277   1          // 进入中断设置IP，不可删除
 278   1          __IRQnIPnPush(ADC_IRQn);
 279   1      
 280   1          // ---------------- 用户函数处理 -------------------
 281   1      
 282   1          if (ADC_STA & ADC_CHAN0_DONE(0x01))
 283   1          {
 284   2              ADC_STA |= ADC_CHAN0_DONE(0x01);                 // 清除ADC0转换完成标志位
 285   2              adc_val = (ADC_DATAH0 << 4) | (ADC_DATAL0 >> 4); // 先接收ad值
 286   2      
 287   2              switch (cur_adc_status)
 288   2              {
 289   3              case ADC_STATUS_SEL_AD_KEY:
 290   3                  adc_update_val(ADC_CHANNEL_SEL_AD_KEY, adc_val);
 291   3                  break;
 292   3              case ADC_STATUS_SEL_BAT_DET:
 293   3                  adc_update_val(ADC_CHANNEL_SEL_BAT_DET, adc_val);
 294   3                  battery_voltage_update_by_isr();
 295   3                  break;
 296   3              case ADC_STATUS_SEL_SOLAR_DET:
 297   3                  adc_update_val(ADC_CHANNEL_SEL_SOLAR_DET, adc_val);
 298   3                  break;
 299   3              case ADC_STATUS_SEL_TYPE_C:
C51 COMPILER V9.60.7.0   ADC                                                               07/31/2026 17:59:07 PAGE 6   

 300   3                  adc_update_val(ADC_CHANNEL_SEL_TYPE_C, adc_val);
 301   3                  break;
 302   3      
 303   3              default:
 304   3                  break;
 305   3              }
 306   2          }
 307   1      
 308   1          // 退出中断设置IP，不可删除
 309   1          __IRQnIPnPop(ADC_IRQn);
 310   1      }


