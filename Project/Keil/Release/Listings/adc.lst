 158          void adc_channel_sel(adc_channel_sel_t adc_channel)
 159          {
 160   1          ADC_ACON1 &= ~(ADC_VREF_SEL(0x07) |  // 清空参考电压选择位
 161   1                         ADC_EXREF_SEL(0x01) | // 关闭外部参考电压
 162   1                         ADC_INREF_SEL(0x01)); // 关闭内部参考电压
 163   1      
 164   1          switch (adc_channel)
 165   1          {
 166   2          case ADC_CHANNEL_SEL_AD_KEY:
 167   2              // ADC配置
 168   2              ADC_ACON1 |= ADC_VREF_SEL(0x06) | // 选择 VCC 作为参考电压
 169   2                           ADC_TEN_SEL(0x03);   // 关闭测试信号
 170   2              ADC_CHS0 = ADC_ANALOG_CHAN(0x14); // 选则引脚对应的通道（0x14--P24）
 171   2              break;
 172   2          case ADC_CHANNEL_SEL_BAT_DET:
 173   2              ADC_ACON1 |= ADC_VREF_SEL(0x01) | // 选择 内部2.0V 作为参考电压
 174   2                           ADC_TEN_SEL(0x03) |  // 关闭测试信号
 175   2                           ADC_INREF_SEL(0x01); // 使能内部参考电压
 176   2              ADC_CHS0 = ADC_EXT_SEL(0x01) |    // 选择内部通道
C51 COMPILER V9.60.7.0   ADC                                                               07/31/2026 17:59:07 PAGE 4   

 177   2                         ADC_ANALOG_CHAN(0x03); // 选择 VDD 1/5 分压的通道
 178   2              break;
 179   2          case ADC_CHANNEL_SEL_SOLAR_DET:
 180   2              //  0 ~ 5 V， 经过二极管0.3V后，实际的充电电压范围：0 ~ 4.7V
 181   2              // 经过 1/2 分压后，单片机检测到的电压范围：0 ~ 2.35V
 182   2              // 使用2.4V参考电压
 183   2              ADC_ACON1 |= ADC_VREF_SEL(0x02) | // 选择 内部2.4V 作为参考电压
 184   2                           ADC_TEN_SEL(0x03) |  // 关闭测试信号
 185   2                           ADC_INREF_SEL(0x01); // 使能内部参考电压
 186   2              ADC_CHS0 = ADC_ANALOG_CHAN(0x0C); // 选则引脚对应的通道（0x0C -- P14）
 187   2              break;
 188   2      
 189   2          case ADC_CHANNEL_SEL_TYPE_C:
 190   2              ADC_ACON1 |= ADC_VREF_SEL(0x02) | // 选择 内部 2.4V 作为参考电压
 191   2                           ADC_TEN_SEL(0x03) |  // 关闭测试信号
 192   2                           ADC_INREF_SEL(0x01); // 使能内部参考电压
 193   2              ADC_CHS0 = ADC_ANALOG_CHAN(0x0E); // 选则引脚对应的通道（0x0E -- P16）
 194   2              break;
 195   2      
 196   2          default:
 197   2              break;
 198   2          }
 199   1      
 200   1          ADC_CFG0 |= ADC_CHAN0_EN(0x1) | // 使能通道0
 201   1                      ADC_EN(0x1);        // 使能adc
 202   1      }
