 278          void ADC_IRQHandler(void) interrupt ADC_IRQn
 279          {
 280   1          volatile u16 adc_val;
 281   1      
 282   1          // 进入中断设置IP，不可删除
 283   1          __IRQnIPnPush(ADC_IRQn);
 284   1      
 285   1          // ---------------- 用户函数处理 -------------------
 286   1      
 287   1          if (ADC_STA & ADC_CHAN0_DONE(0x01))
 288   1          {
 289   2              ADC_STA |= ADC_CHAN0_DONE(0x01);                 // 清除ADC0转换完成标志位
 290   2              adc_val = (ADC_DATAH0 << 4) | (ADC_DATAL0 >> 4); // 先接收ad值
 291   2               
 292   2              switch (cur_adc_status)
 293   2              {
 294   3              case ADC_STATUS_SEL_AD_KEY:
 295   3                  adc_update_val(ADC_CHANNEL_SEL_AD_KEY, adc_val);
 296   3                  break;
 297   3              case ADC_STATUS_SEL_BAT_DET:
 298   3                  adc_update_val(ADC_CHANNEL_SEL_BAT_DET, adc_val);  
 299   3                  battery_voltage_update_by_isr();
C51 COMPILER V9.60.7.0   ADC                                                               07/24/2026 13:53:24 PAGE 6   

 300   3                  break;
 301   3              case ADC_STATUS_SEL_SOLAR_DET:
 302   3                  adc_update_val(ADC_CHANNEL_SEL_SOLAR_DET, adc_val);
 303   3                  break;
 304   3              case ADC_STATUS_SEL_TYPE_C:
 305   3                  adc_update_val(ADC_CHANNEL_SEL_TYPE_C, adc_val);
 306   3                  break;
 307   3      
 308   3              default:
 309   3                  break;
 310   3              }
 311   2          }
 312   1      
 313   1          // 退出中断设置IP，不可删除
 314   1          __IRQnIPnPop(ADC_IRQn);
 315   1      }


