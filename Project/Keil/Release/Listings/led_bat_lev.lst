 587   2                      led_bat_lev = LED_BAT_LEV_2;
 588   2              }
 589   1              else if (charge_time_cnt >= BAT_CHARGE_1LED_TIME &&
 590   1                               (led_charge_anim_phase == 0 ||
 591   1                                led_charge_anim_phase == 1))
 592   1              {
 593   2                      led_charge_anim_phase = 1;
 594   2                      LED_25_PERCENT_ON(); //
 595   2      
 596   2                      led_bat_lev = LED_BAT_LEV_1;
