 578   2                      LED_75_PERCENT_ON(); //
 579   2      
 580   2                      led_bat_lev = LED_BAT_LEV_3;
 581   2              }
 582   1              else if (charge_time_cnt >= BAT_CHARGE_2LED_TIME &&
 583   1                               (led_charge_anim_phase == 1 ||
 584   1                                led_charge_anim_phase == 2))
 585   1              {
 586   2                      led_charge_anim_phase = 2;
 587   2                      LED_50_PERCENT_ON(); //
 588   2      
 589   2                      led_bat_lev = LED_BAT_LEV_2;
 590   2              }
 591   1              else if (charge_time_cnt >= BAT_CHARGE_1LED_TIME &&
 592   1                               (led_charge_anim_phase == 0 ||
 593   1                                led_charge_anim_phase == 1))
 594   1              {
 595   2                      led_charge_anim_phase = 1;
 596   2                      LED_25_PERCENT_ON(); //
 597   2      
 598   2                      led_bat_lev = LED_BAT_LEV_1;
