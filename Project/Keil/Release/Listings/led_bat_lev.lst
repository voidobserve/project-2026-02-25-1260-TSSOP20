 508          static void led_bat_lev_sta_charging_handle(void)
 509          {
 510   1              static volatile u32 led_quick_fill_cnt = 0; // 充满电时，快速填充的计数值
 511   1      
 512   1              led_charge_anim_cnt++;
 513   1              // 正在充电，让当前电量对应的指示灯闪烁（只闪烁一个灯）
 514   1              // led_charge_anim_cnt == 0，说明刚进入这个阶段，也需要对应的指示灯状态翻转一次
 515   1              if (led_charge_anim_cnt >= 500 || led_charge_anim_cnt == 0)
 516   1              {
 517   2                      led_charge_anim_cnt = 0;
 518   2      
 519   2                      // 根据 LED_BAT_LEVEL_STA_CHARGE_BEGIN_ANIM 期间更新的值，让对应的指示灯闪烁
 520   2                      switch (led_charge_anim_phase)
 521   2                      {
 522   3                      case 0:
 523   3                              LED_25_PERCENT_TOGGLE();
 524   3                              break;
 525   3                      case 1:
 526   3                              LED_50_PERCENT_TOGGLE();
 527   3                              break;
 528   3                      case 2:
 529   3                              LED_75_PERCENT_TOGGLE();
 530   3                              break;
 531   3                      case 3:
 532   3                              LED_100_PERCENT_TOGGLE();
 533   3                              break;
 534   3                      }
 535   2              }
 536   1      
 537   1              if ((is_in_charging_by_charger || // 通过充电器充电，或者通过太阳能充电
 538   1                       is_in_charging_by_solar_panel) &&
 539   1                      is_charging_ic_stop) // 充电IC报告停止，认为充满电，进入快速填充显示状态
 540   1              {
