 563   4                              }
 564   3                      }
 565   2              }
 566   1              else
 567   1              {
 568   2                      led_quick_fill_cnt = 0;
 569   2              }
 570   1      
 571   1              if (charge_time_cnt >= BAT_CHARGE_3LED_TIME &&
 572   1                      (led_charge_anim_phase == 2 ||
 573   1                       led_charge_anim_phase == 3))
 574   1              {
 575   2                      led_charge_anim_phase = 3;
 576   2                      LED_75_PERCENT_ON(); //
 577   2      
 578   2                      led_bat_lev = LED_BAT_LEV_3;
 579   2              }
 580   1              else if (charge_time_cnt >= BAT_CHARGE_2LED_TIME &&
