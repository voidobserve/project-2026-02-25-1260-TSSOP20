 563   4                                      led_bat_lev++; // 如果是充满电，这里会对应满电的值
 564   4                                      led_charge_anim_phase++;
 565   4                              }
 566   3                      }
 567   2              }
 568   1              else
 569   1              {
 570   2                      led_quick_fill_cnt = 0;
 571   2              }
 572   1      
 573   1              if (charge_time_cnt >= BAT_CHARGE_3LED_TIME &&
