 542   2                      if (led_bat_lev >= LED_BAT_LEV_4)
 543   2                      {
 544   3                              led_bat_lev_sta = LED_BAT_LEV_STA_CHARGE_END;
 545   3                      }
 546   2                      else
 547   2                      {
C51 COMPILER V9.60.7.0   LED_BAT_LEV                                                       07/29/2026 17:46:39 PAGE 10  

 548   3                              // 如果已经满电，但是当前没有显示4个指示灯
