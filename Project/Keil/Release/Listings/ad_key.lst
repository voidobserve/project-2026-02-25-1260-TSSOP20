  63   2              if (ad_key_val < ad_key_scan_table[i][1])
  64   2              {
  65   3                  ad_key_index = ad_key_scan_table[i][0];
  66   3                  break;
  67   3              }
  68   2          }
  69   1      
  70   1          return ad_key_index;
  71   1      }
