 191   1          WUT_CONL &= ~TMR_MODE_SEL(0x1);   // 不使能计数
 192   1      
 193   1          // 不使能唤醒通道
 194   1          LP_WKCON &= ~(LP_WKUP_0_EN(0x01) |
 195   1                        LP_WKUP_1_EN(0x01) |
 196   1                        LP_WKUP_2_EN(0x01));
 197   1      
 198   1          FIN_S10 = GPIO_FIN_SEL_GND;
 199   1          FIN_S11 = GPIO_FIN_SEL_GND;
