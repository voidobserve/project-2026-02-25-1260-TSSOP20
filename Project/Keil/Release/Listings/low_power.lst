 363          
 364          // wake up timer 中断服务函数
 365          void WUT_IRQHandler(void) interrupt WUT_IRQn
 366          {
 367   1          // 进入中断设置IP，不可删除
 368   1          __IRQnIPnPush(WUT_IRQn);
 369   1      
 370   1          // ---------------- 用户函数处理 -------------------
 371   1      
 372   1          // 周期中断
 373   1          if (WUT_CONH & TMR_PRD_PND(0x1))
 374   1          {
 375   2              WUT_CONH |= TMR_PRD_PND(0x1); // 清除pending
 376   2          }
 377   1      
 378   1          // 退出中断设置IP，不可删除
 379   1          __IRQnIPnPop(WUT_IRQn);
 380   1      }


