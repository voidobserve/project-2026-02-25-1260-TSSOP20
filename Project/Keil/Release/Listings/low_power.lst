   5          
   6          // 判断进入低功耗的条件是否成立
   7          u8 is_low_power_condition_establish(void)
   8          {
   9   1          /*
  10   1              蓝牙ic正在工作、灯光打开、正在充电，
  11   1              检测到充电ic输出放电信号
  12   1              返回0，表示不进入低功耗
  13   1          */
  14   1          return !(ble_ic.is_working ||
  15   1                   (led_ctl.status != LED_STATUS_OFF) ||
  16   1                   is_in_charging ||
  17   1                   is_in_discharging ||
  18   1                   is_detect_discharge_signal);
  19   1      }
  20          
  21          // 进入低功耗的条件成立，则累加时间，满足时间后进入低功耗
  22          void low_power_enter_timer_callback(void)
  23          {
  24   1          static volatile u32 cnt = 0;
  25   1          if (is_low_power_condition_establish())
  26   1          {
  27   2              cnt++;
  28   2              // 等待较长时间，等到电池电压稳定后，再进入低功耗
  29   2              if (cnt >= LOW_POWER_ENTER_TIME_WHEN_POWER_OFF)
  30   2              {
  31   3                  cnt = 0;
  32   3                  is_low_power_enter_enable = 1;
  33   3              }
  34   2          }
  35   1          else
  36   1          {
  37   2              cnt = 0;
  38   2              is_low_power_enter_enable = 0;
  39   2          }
  40   1      }
